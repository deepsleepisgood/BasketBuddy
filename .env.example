# Which LLM provider to use: groq | gemini | anthropic | openai
# If unset, the first provider with a key below is used (in that order).
LLM_PROVIDER=groq

# Only the key for your chosen provider is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults live in config.py)
# LLM_MODEL=        # final grounded answer
# LLM_FAST_MODEL=   # classification / extraction / decomposition
